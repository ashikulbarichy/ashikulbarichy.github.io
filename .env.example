# This file shows the environment variables that would be needed for a production deployment
# For this demo version, all data is mocked and no environment variables are required

# Example environment variables for future API integration:
# NEXT_PUBLIC_API_URL=https://your-api-domain.com/api
# CONTACT_EMAIL=your-email@domain.com
# NEWSLETTER_API_KEY=your-newsletter-service-api-key

# Google Analytics (GA4)
VITE_GA_ID=G-XXXXXXXXXX

# Sanity CMS Integration Configurations
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2023-05-03
VITE_SANITY_API_TOKEN=your_sanity_api_token