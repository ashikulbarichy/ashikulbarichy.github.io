# On Vercel, every NEXT_PUBLIC_* variable must be set to visibility
# "Config"/"Plain" — Vercel rejects Secret/Sensitive for them, because Next
# inlines those values into the browser bundle. The unprefixed ones below
# should be Secret/Sensitive. See SECURITY.md.

# ── Sanity ───────────────────────────────────────────────────────────────────
# The production dataset is public, so the site needs no API token to read it.
# NEVER put a Sanity token in a NEXT_PUBLIC_ variable: anything with that
# prefix is inlined into the browser bundle and readable by anyone.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2023-05-03

# ── Site ─────────────────────────────────────────────────────────────────────
# Must exactly match the host the site serves on, with no redirect in between.
# Everything canonical is derived from this: canonical tags, OG urls, sitemap
# entries, JSON-LD @ids.
NEXT_PUBLIC_SITE_URL=https://www.ashikulbari.com

# Google Analytics 4 measurement ID. Omit to disable analytics entirely.

# ── Server-only ──────────────────────────────────────────────────────────────
# Shared secret for the Sanity -> /api/revalidate webhook.
SANITY_REVALIDATE_SECRET=generate_a_long_random_string

# Editor token, used ONLY by scripts/seed-seo.mjs from your machine.
# Not needed at runtime and must not be added to Vercel.
SANITY_WRITE_TOKEN=

# ── Supabase (SAM analytics dashboard at /sam) ────────────────────────────────
# Project settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# SERVER ONLY. Bypasses Row Level Security completely.
# Never prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Only this address may open /sam, checked on top of Supabase auth and the
# admins table. Leave blank to rely on the admins table alone.
SAM_ALLOWED_EMAIL=

# Salt for the daily-rotating visitor hash. Any long random string.
# Changing it resets unique-visitor counting from that day forward.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SALT=generate_a_long_random_string
